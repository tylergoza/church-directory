# systemd unit for running the binary directly (no Docker). Install:
#   sudo useradd --system --home-dir /var/lib/church-directory --shell /usr/sbin/nologin directory
#   sudo install -m 755 church-directory-linux-amd64 /usr/local/bin/church-directory
#   sudo cp church-directory.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now church-directory
# Edit TZ below first. Run commands as the service user against the same
# database, flags before the command:
#   sudo -u directory church-directory -db /var/lib/church-directory/directory.db create-user alice --admin
# Logs: journalctl -u church-directory -f
[Unit]
Description=Church Member Directory
After=network.target

[Service]
User=directory
StateDirectory=church-directory
Environment=ADDR=127.0.0.1:8130
Environment=DB_PATH=/var/lib/church-directory/directory.db
Environment=TZ=America/Chicago
# Caddy (deploy/Caddyfile) is in front; it's the only thing that can reach
# 127.0.0.1:8130, so its X-Forwarded-* headers can be trusted.
Environment=TRUST_PROXY=1
ExecStart=/usr/local/bin/church-directory
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
